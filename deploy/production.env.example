# Environment for the deployed container. No AWS keys here: the container gets
# credentials from its ECS task role (see task-role-policy.json).
NODE_ENV=production
PORT=3001
AWS_REGION=us-east-1

HAUNT_PROVIDER=bedrock
HAUNT_BEDROCK_API=converse
HAUNT_STORY_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0
HAUNT_AGENT_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0
HAUNT_MATCH_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0

HAUNT_TTS=polly
HAUNT_POLLY_VOICE=Matthew
HAUNT_POLLY_ENGINE=generative

# Server speech recognition for browsers without their own (e.g. Brave): off | mock | transcribe.
# "transcribe" uses Amazon Transcribe streaming, billed per second of recorded audio.
HAUNT_STT=off
# Behind the Express Mode load balancer: use the real client IP for rate limits.
HAUNT_TRUST_PROXY=1

# Container disks are wiped on restart, so stories must live in DynamoDB.
HAUNT_STORE=dynamodb
HAUNT_TABLE_NAME=haunt-stories
# Stories are deleted this many days after their last turn (DynamoDB TTL on "expiresAt"). 45 keeps
# anything played from mid-October through judging (ends Nov 20). "0" keeps stories forever.
HAUNT_STORY_TTL_DAYS=45

# External MCP clients need one of these bearer tokens (comma-separated, 16+ characters).
# Inject from Secrets Manager or SSM Parameter Store (SecureString), never in this file.
# HAUNT_MCP_TOKENS=

# Set from a secret (SSM Parameter Store SecureString), never in this file.
