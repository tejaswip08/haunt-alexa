        {
          "when": "${state.pressed || state.focused}",
          "backgroundColor": "#F2EBDD"
        }
      ]
    },
    "hauntButtonLabel": {
      "values": [
        {
          "color": "#ECE6DA"
        },
        {
          "when": "${state.pressed || state.focused}",
          "color": "#07080A"
        }
      ]
    }
  },
