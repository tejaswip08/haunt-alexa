  "onMount": [
    {
      "type": "Parallel",
      "commands": [
        {
          "type": "AnimateItem",
          "componentId": "hauntTitle",
          "duration": 3000,
          "easing": "ease-out",
          "value": [
            {
              "property": "opacity",
              "from": 0,
              "to": 1
            },
            {
              "property": "transform",
              "from": [
                {
                  "scale": 1.08
                }
              ],
              "to": [
                {
                  "scale": 1
                }
              ]
            }
          ]
        },
        {
          "type": "AnimateItem",
          "componentId": "hauntDivider",
          "delay": 1800,
          "duration": 1200,
          "value": [
            {
              "property": "opacity",
              "from": 0,
              "to": 1
            }
          ]
        },
        {
          "type": "AnimateItem",
          "componentId": "hauntSubtitle",
          "delay": 2200,
          "duration": 2000,
          "value": [
            {
              "property": "opacity",
              "from": 0,
              "to": 1
            }
          ]
        },
        {
          "type": "AnimateItem",
          "componentId": "hauntContinue",
          "delay": 3400,
          "duration": 1200,
          "value": [
            {
              "property": "opacity",
              "from": 0,
              "to": 1
            }
          ]
        },
        {
          "type": "AnimateItem",
          "componentId": "fogBack",
          "duration": 14000,
          "easing": "ease-in-out",
          "repeatCount": 1000,
          "repeatMode": "reverse",
          "value": [
            {
              "property": "transform",
              "from": [
                {
                  "translateX": -60
                }
              ],
              "to": [
                {
                  "translateX": 60
                }
              ]
            }
          ]
        },
        {
          "type": "AnimateItem",
          "componentId": "fogFront",
          "duration": 10000,
          "easing": "ease-in-out",
          "repeatCount": 1000,
          "repeatMode": "reverse",
          "value": [
            {
              "property": "transform",
              "from": [
                {
                  "translateX": 50
                }
              ],
              "to": [
                {
                  "translateX": -50
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "mainTemplate": {
    "parameters": [
      "payload"
    ],
    "items": [
      {
        "type": "Container",
        "width": "100vw",
        "height": "100vh",
        "bind": [
          {
            "name": "tall",
            "type": "boolean",
            "value": "${viewport.width <= viewport.height}"
          },
          {
            "name": "titleSize",
            "type": "number",
            "value": "${Math.min(viewport.width * 0.13, viewport.height * 0.2)}"
          },
          {
            "name": "subtitleSize",
            "type": "number",
            "value": "${Math.max(18, Math.min(viewport.width * 0.035, viewport.height * 0.042))}"
          },
          {
            "name": "fogHeight",
            "type": "number",
            "value": "${Math.min(viewport.height * 0.45, viewport.width * 0.35)}"
          },
          {
            "name": "btnFont",
            "type": "number",
            "value": "${Math.max(18, subtitleSize * 0.85)}"
          },
          {
            "name": "btnHeight",
            "type": "number",
            "value": "${Math.max(44, subtitleSize * 2.1)}"
          }
        ],
        "items": [
          {
            "type": "VectorGraphic",
            "source": "hauntScene",
            "position": "absolute",
            "width": "100%",
            "height": "100%",
            "scale": "best-fill",
            "align": "${tall ? 'right' : 'top'}"
          },
          {
            "type": "VectorGraphic",
            "id": "fogBack",
            "source": "hauntFog",
            "position": "absolute",
            "left": "-25vw",
            "bottom": "4vh",
            "width": "150vw",
            "height": "${fogHeight}",
            "scale": "fill",
            "opacity": 0.7
          },
          {
            "type": "Container",
            "position": "absolute",
            "top": 0,
            "bottom": 0,
            "left": 0,
            "right": 0,
            "justifyContent": "center",
            "alignItems": "center",
            "paddingLeft": "${viewport.shape == 'round' ? '12vw' : '6vw'}",
            "paddingRight": "${viewport.shape == 'round' ? '12vw' : '6vw'}",
            "items": [
              {
                "type": "Text",
                "id": "hauntTitle",
                "text": "${payload.welcome.title}",
                "opacity": 0,
                "fontFamily": "Bookerly",
                "fontSize": "${titleSize}",
                "fontWeight": "300",
                "letterSpacing": "${titleSize * 0.15}",
                "paddingLeft": "${titleSize * 0.15}",
                "color": "#e8e0d2",
                "textAlign": "center"
              },
              {
                "type": "Frame",
                "id": "hauntDivider",
                "opacity": 0,
                "width": "14vw",
                "height": 2,
                "backgroundColor": "#8b0a14"
              },
              {
                "type": "Text",
                "id": "hauntSubtitle",
                "text": "${payload.welcome.subtitle}",
                "opacity": 0,
                "paddingTop": "${subtitleSize * 0.7}",
                "fontFamily": "Bookerly",
                "fontSize": "${subtitleSize}",
                "fontStyle": "italic",
                "letterSpacing": "${subtitleSize * 0.07}",
                "color": "#b5a998",
                "textAlign": "center"
              },
              {
                "type": "TouchWrapper",
                "id": "hauntContinue",
                "opacity": 0,
                "spacing": "${subtitleSize * 1.5}",
                "onPress": [
                  {
                    "type": "SendEvent",
                    "arguments": [
                      "continue"
                    ]
                  }
                ],
                "item": {
                  "type": "Frame",
                  "inheritParentState": true,
                  "style": "hauntButtonPrimary",
                  "borderRadius": "${btnHeight * 0.17}",
                  "height": "${btnHeight}",
                  "paddingLeft": "${btnHeight * 0.8}",
                  "paddingRight": "${btnHeight * 0.8}",
                  "item": {
                    "type": "Text",
                    "inheritParentState": true,
                    "style": "hauntButtonLabel",
                    "text": "${payload.welcome.continueLabel}",
                    "height": "100%",
                    "textAlignVertical": "center",
                    "fontFamily": "Amazon Ember Display",
                    "fontWeight": "500",
                    "fontSize": "${btnFont}",
                    "letterSpacing": "${btnFont * 0.04}",
                    "maxLines": 1
                  }
                }
              }
            ]
          },
          {
            "type": "VectorGraphic",
            "id": "fogFront",
            "source": "hauntFog",
            "position": "absolute",
            "left": "-25vw",
            "bottom": "${-fogHeight * 0.25}",
            "width": "150vw",
            "height": "${fogHeight * 0.9}",
            "scale": "fill",
            "opacity": 0.5
          }
        ]
      }
    ]
  }
}
