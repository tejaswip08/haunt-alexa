{
  "type": "APL",
  "version": "2023.3",
  "description": "Play mode. Port of apps/tv/src/screens/PlayModeScreen.tsx: asked before every playthrough.",
  "theme": "dark",
  "layouts": {
    "ModeCard": {
      "parameters": [
        "icon",
        "title",
        "detail",
        "mode"
      ],
      "item": {
        "type": "TouchWrapper",
        "spacing": "${32 * u}",
        "onPress": [
          {
            "type": "SendEvent",
            "arguments": [
              "mode",
              "${mode}"
            ]
          }
        ],
        "item": {
          "type": "Frame",
          "inheritParentState": true,
          "style": "crimsonPress",
          "width": "${Math.max(220, 520 * u)}",
          "borderRadius": "${18 * u}",
          "borderWidth": "${Math.max(2, 3 * u)}",
          "padding": "${Math.max(14, 36 * u)}",
          "item": {
            "type": "Container",
            "alignItems": "center",
            "items": [
              {
                "type": "Frame",
                "width": "${Math.max(44, 84 * u)}",
                "height": "${Math.max(44, 84 * u)}",
                "borderRadius": "${Math.max(22, 42 * u)}",
                "borderWidth": 2,
                "borderColor": "#ECE6DA4D",
                "item": {
                  "type": "Container",
                  "width": "100%",
                  "height": "100%",
                  "justifyContent": "center",
                  "alignItems": "center",
                  "items": [
                    {
                      "type": "Icon",
                      "name": "${icon}",
                      "size": "${Math.max(22, 42 * u)}"
                    }
                  ]
                }
              },
              {
                "type": "Text",
                "text": "${title}",
                "spacing": "${22 * u}",
                "textAlign": "center",
                "fontFamily": "Bookerly",
                "fontWeight": "bold",
                "fontSize": "${Math.max(20, 40 * u)}",
                "color": "@text"
              },
              {
                "type": "Text",
                "text": "${detail}",
                "spacing": "${10 * u}",
                "textAlign": "center",
                "fontFamily": "Bookerly",
                "fontStyle": "italic",
                "fontSize": "${Math.max(14, 25 * u)}",
                "lineHeight": 1.3,
                "color": "@textMuted"
              }
            ],
            "height": "100%",
            "justifyContent": "center"
          },
          "height": "100%"
        },
        "height": "${cardH}"
      }
    }
  },
  "mainTemplate": {
    "parameters": [
      "payload"
    ],
    "items": [
      {
        "type": "Container",
        "width": "100vw",
        "height": "100vh",
        "bind": [
          {
            "name": "u",
            "type": "number",
            "value": "${Math.min(viewport.width / 1920, viewport.height / 1080)}"
          },
          {
            "name": "cardH",
            "type": "number",
            "value": "${Math.max(230, 400 * u)}"
          }
        ],
        "items": [
          {
            "type": "Frame",
            "position": "absolute",
            "width": "100%",
            "height": "100%",
            "backgroundColor": "@background"
          },
          {
            "type": "SceneArt",
            "art": "${payload.playmode.art}"
          },
          {
            "type": "Frame",
            "position": "absolute",
            "width": "100%",
            "height": "100%",
            "backgroundColor": "#050507C7"
          },
          {
            "type": "Container",
            "position": "absolute",
            "width": "100%",
            "height": "100%",
            "justifyContent": "center",
            "alignItems": "center",
            "paddingLeft": "5vw",
            "paddingRight": "5vw",
            "items": [
              {
                "type": "Text",
                "text": "HORROR · ${payload.playmode.subgenreName}",
                "textAlign": "center",
                "fontFamily": "Amazon Ember Display",
                "fontWeight": "bold",
                "fontSize": "${Math.max(12, 20 * u)}",
                "letterSpacing": "${5 * u}",
                "color": "@accentBright"
              },
              {
                "type": "Text",
                "text": "${payload.playmode.title}",
                "spacing": "${6 * u}",
                "textAlign": "center",
                "maxLines": 2,
                "fontFamily": "Bookerly",
                "fontWeight": "bold",
                "fontSize": "${Math.max(32, 96 * u)}",
                "color": "@text"
              },
              {
                "type": "Text",
                "text": "${payload.playmode.subtitle}",
                "textAlign": "center",
                "fontFamily": "Bookerly",
                "fontStyle": "italic",
                "fontSize": "${Math.max(16, 34 * u)}",
                "color": "@text",
                "opacity": 0.85
              },
              {
                "type": "Text",
                "text": "How do you want to play?",
                "spacing": "${Math.max(18, 64 * u)}",
                "textAlign": "center",
                "fontFamily": "Bookerly",
                "fontWeight": "bold",
                "fontSize": "${Math.max(22, 48 * u)}",
                "color": "@text"
              },
              {
                "type": "Container",
                "direction": "${viewport.width < viewport.height ? 'column' : 'row'}",
                "spacing": "${Math.max(16, 44 * u)}",
                "alignItems": "center",
                "items": [
                  {
                    "type": "ModeCard",
                    "icon": "iconBranch",
                    "title": "Play with choices",
                    "detail": "You decide what happens next. ${payload.playmode.extent}.",
                    "mode": "choices"
                  },
                  {
                    "type": "ModeCard",
                    "icon": "iconHeadphones",
                    "title": "Listen without choices",
                    "detail": "Sit back. The narrator tells the story straight through, no decisions.",
                    "mode": "listen"
                  }
                ]
              }
            ]
          },
          {
            "type": "Container",
            "position": "absolute",
            "top": "5vh",
            "left": "4vw",
            "items": [
              {
                "type": "HButton",
                "label": "‹  Back",
                "action": "back",
                "variant": "ghost",
                "compact": true
              }
            ]
          }
        ]
      }
    ]
  }
}
