# Copy to .env and adjust. Every value here has a sensible default.

# API server port (production hosts usually set PORT instead)
HAUNT_PORT=3001

# Who writes scenes and who plays the simulated Alexa+ assistant: "bedrock" or "mock".
# "mock" runs everything offline with no AWS credentials.
HAUNT_PROVIDER=bedrock
# HAUNT_AGENT=bedrock

# Amazon Bedrock (credentials come from the standard AWS chain: env vars, ~/.aws, or a role)
AWS_REGION=us-east-1
HAUNT_STORY_MODEL=anthropic.claude-sonnet-5-5
HAUNT_AGENT_MODEL=anthropic.claude-sonnet-5-5
HAUNT_FALLBACK_MODEL=anthropic.claude-opus-5-5

# Narration: "polly" (default) or "browser"
HAUNT_TTS=polly
HAUNT_POLLY_VOICE=Matthew
HAUNT_POLLY_ENGINE=generative

# Server speech recognition for browsers that can't recognise speech themselves (e.g. Brave):
# "off" (default), "mock" (fixed offline transcript, for testing) or "transcribe"
# (Amazon Transcribe streaming; billed per second of audio). Recordings are never stored.
# HAUNT_STT=off
# HAUNT_STT_ORIGINS=https://haunt.example.com
# HAUNT_TRUST_PROXY=1   # behind a load balancer, so rate limits see the real client IP

# Where stories and published episodes are stored: "file" (./data, default) or "dynamodb"
# (cloud only; see deploy/DEPLOY.md). Copy local data with: npm run migrate:dynamodb -w @haunt/server
HAUNT_STORE=file
# HAUNT_TABLE_NAME=haunt-stories
# HAUNT_STORY_TTL_DAYS=30   # DynamoDB only: delete stories 30 days after their last turn (0 keeps them)

# Bearer tokens for external MCP clients on /mcp (comma-separated, 16+ characters).
# Unset in development = /mcp is open on localhost. Unset in production = /mcp is closed.
# HAUNT_MCP_TOKENS=
# HAUNT_DATA_DIR=./data

# Pre-write a scene per suggested answer ("off" to disable)
# HAUNT_PREWRITE=on
# HAUNT_MATCH_MODEL=anthropic.claude-haiku-4-5

# Secret for the admin publishing page (/admin). Publishing is disabled when unset.

# Sign-in. With a Cognito user pool (HAUNT_COGNITO_USER_POOL_ID + HAUNT_COGNITO_CLIENT_ID) listeners
# sign in with emailed codes. "mock" tries the same flow offline: codes print in this console.
# Development only (refused when NODE_ENV=production).
# HAUNT_AUTH=mock
# Public address for the "scan to sign in" QR code shown on TVs (/activate). Defaults to the
# address the TV used to reach the server.
# HAUNT_PUBLIC_URL=https://haunt.example.com
